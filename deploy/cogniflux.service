[Unit]
Description=Cogniflux - research & learning platform (Next.js standalone)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/cogniflux
ExecStart=/home/ubuntu/cogniflux/scripts/start_prod.sh
Restart=on-failure
RestartSec=5
# Hardening: app only ever needs its own files + loopback
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/cogniflux

# Memory guard: matches NODE_OPTIONS cap inside start_prod.sh plus headroom.
# The VPS has 3.7GB total; a runaway node process must never OOM the box.
MemoryMax=1G
MemoryHigh=800M

Environment=NODE_ENV=production
# Pin Node 22 explicitly. /usr/bin/node on this VPS is v18, which cannot
# require() ESM-only packages (html-encoding-sniffer -> @exodus/bytes) — the
# fulltext/reader routes 500 with ERR_REQUIRE_ESM under it. The v22 runtime at
# /home/ubuntu/.hermes/node/bin/node supports require(esm) natively.
Environment=PATH=/home/ubuntu/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

[Install]
WantedBy=multi-user.target
